    <ui:InvokeCode Code="For Each item As Dictionary(Of String, Object) In io_ExtractedData&#xA;    Dim cleanedValues As New Dictionary(Of String, Object)&#xA;    &#xA;    For Each kvp In item&#xA;        Dim key As String = kvp.Key&#xA;        Dim rawValue As String = If(kvp.Value IsNot Nothing, kvp.Value.ToString(), &quot;&quot;)&#xA;        &#xA;        If String.IsNullOrWhiteSpace(rawValue) OrElse key.StartsWith(&quot;_&quot;) Then Continue For&#xA;&#xA;        Dim keyLower As String = key.ToLower()&#xA;&#xA;        If keyLower.Contains(&quot;date&quot;) Then&#xA;            Dim dt As DateTime&#xA;            If DateTime.TryParse(rawValue, dt) Then&#xA;                cleanedValues(key) = dt.ToString(&quot;yyyy-MM-dd&quot;)&#xA;            End If&#xA;        &#xA;        ElseIf keyLower.Contains(&quot;amount&quot;) OrElse keyLower.Contains(&quot;total&quot;) OrElse keyLower.Contains(&quot;due&quot;) OrElse keyLower.Contains(&quot;balance&quot;) Then&#xA;            Dim cleanNum As String = System.Text.RegularExpressions.Regex.Replace(rawValue, &quot;[^\d\.]&quot;, &quot;&quot;)&#xA;            Dim parsed As Double&#xA;            If Double.TryParse(cleanNum, parsed) Then&#xA;                cleanedValues(key) = parsed.ToString(&quot;F2&quot;)&#xA;            End If&#xA;        End If&#xA;    Next&#xA;&#xA;    For Each kvp In cleanedValues&#xA;        item(kvp.Key) = kvp.Value&#xA;    Next&#xA;&#xA;    item(&quot;_PortalName&quot;) = portalName&#xA;    item(&quot;_ExtractionDate&quot;) = DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)&#xA;    item(&quot;_ExtractionSuccess&quot;) = &quot;True&quot;&#xA;    &#xA;    If config.ContainsKey(&quot;NotificationEmail&quot;) Then&#xA;        item(&quot;RecipientEmail&quot;) = config(&quot;NotificationEmail&quot;).ToString()&#xA;    Else&#xA;        item(&quot;RecipientEmail&quot;) = &quot;&quot;&#xA;    End If&#xA;Next" ContinueOnError="False" DisplayName="Normalize Fields">
