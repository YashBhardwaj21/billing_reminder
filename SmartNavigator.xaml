                                              <InArgument x:TypeArguments="x:Int32" />
                                            </ui:Target.TimeoutMS>
                                          </ui:Target>
                                        </ui:Click.Target>
                                      </ui:Click>
                                      
                                      <Assign sap2010:WorkflowViewState.IdRef="Assign_RandClick1">
                                        <Assign.To>
                                          <OutArgument x:TypeArguments="s:TimeSpan">[v_RandomDelay]</OutArgument>
                                        </Assign.To>
                                        <Assign.Value>
                                          <InArgument x:TypeArguments="s:TimeSpan">[TimeSpan.FromMilliseconds(New Random().Next(800, 2500))]</InArgument>
                                        </Assign.Value>
                                      </Assign>
                                      <Delay Duration="[v_RandomDelay]" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" sap2010:WorkflowViewState.IdRef="Delay_Rand2" />
                                    </Sequence>

                                    <Sequence x:Key="Delay" sap2010:WorkflowViewState.IdRef="Seq_Delay">
                                      <Sequence.Variables>
                                        <Variable x:TypeArguments="s:TimeSpan" Name="v_Delay" />
                                      </Sequence.Variables>
                                      <!-- Best Practice: Clean clear distinct logic for conditional Assigns -->
                                      <If Condition="[step.SelectToken(&quot;Seconds&quot;) Is Nothing]" sap2010:WorkflowViewState.IdRef="If_MissingSeconds">
                                        <If.Then>
                                          <Assign sap2010:WorkflowViewState.IdRef="Assign_DelayDefault">
                                            <Assign.To><OutArgument x:TypeArguments="s:TimeSpan">[v_Delay]</OutArgument></Assign.To>
                                            <Assign.Value><InArgument x:TypeArguments="s:TimeSpan">[TimeSpan.FromSeconds(5)]</InArgument></Assign.Value>
                                          </Assign>
                                        </If.Then>
                                        <If.Else>
                                          <Assign sap2010:WorkflowViewState.IdRef="Assign_DelayExtracted">
                                            <Assign.To><OutArgument x:TypeArguments="s:TimeSpan">[v_Delay]</OutArgument></Assign.To>
                                            <Assign.Value><InArgument x:TypeArguments="s:TimeSpan">[TimeSpan.FromSeconds(CDbl(step.SelectToken("Seconds").Value(Of String)()))]</InArgument></Assign.Value>
                                          </Assign>
                                        </If.Else>
                                      </If>
                                      <Delay Duration="[v_Delay]" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" sap2010:WorkflowViewState.IdRef="Delay_1" />
                                    </Sequence>
                                  </Switch>
                                </Sequence>
                              </ActivityAction>
                            </ui:RetryScope.ActivityBody>
                            <ui:RetryScope.Condition>
                              <ActivityFunc x:TypeArguments="x:Boolean" />
                            </ui:RetryScope.Condition>
                          </ui:RetryScope>
                           
                        </Sequence>
                      </ActivityAction>
                    </ui:ForEach.Body>
                  </ui:ForEach>
                  
                  <If Condition="[Not String.IsNullOrWhiteSpace(postLoginCheck)]" DisplayName="Execute PostLoginCheck" sap2010:WorkflowViewState.IdRef="If_PostLogin">
                    <If.Then>
                      <Sequence DisplayName="PostLogin Verify and Confirm" sap2010:WorkflowViewState.IdRef="Seq_PostLoginWrapper">
                        <TryCatch DisplayName="TryCatch - Post Login Check" sap2010:WorkflowViewState.IdRef="TryCatch_PostLogin">
                          <TryCatch.Try>
                            <Sequence sap2010:WorkflowViewState.IdRef="Seq_VerifyBlock">
                              <ui:UiElementExists DisplayName="Execute ElementExists Validation" Exists="[v_Success]" sap2010:WorkflowViewState.IdRef="ElementExists_Verify">
                                <ui:UiElementExists.Target>
                                  <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Id="23a01419-9a55-4c9a-9d1a-8972cbbb02dd" Selector="[postLoginCheck]" TimeoutMS="15000" WaitForReady="COMPLETE" />
                                </ui:UiElementExists.Target>
                              </ui:UiElementExists>
                              <If Condition="[Not v_Success]" sap2010:WorkflowViewState.IdRef="If_PostLoginFalse">
                                <If.Then>
                                  <Sequence sap2010:WorkflowViewState.IdRef="Seq_ThrowPostErr">
                                    <Assign sap2010:WorkflowViewState.IdRef="Assign_ThrowPostMsg">
                                      <Assign.To><OutArgument x:TypeArguments="x:String">[v_ExceptionMsg]</OutArgument></Assign.To>
                                      <Assign.Value><InArgument x:TypeArguments="x:String">["Post-login dashboard element false/not found: " &amp; postLoginCheck]</InArgument></Assign.Value>
                                    </Assign>
                                    <Throw Exception="[New System.Exception(v_ExceptionMsg)]" sap2010:WorkflowViewState.IdRef="Throw_PostLoginFailed" />
                                  </Sequence>
                                </If.Then>
                              </If>
                            </Sequence>
                          </TryCatch.Try>
                          <TryCatch.Catches>
                            <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_PostLogin">
                              <ActivityAction x:TypeArguments="s:Exception">
                                <ActivityAction.Argument>
                                  <DelegateInArgument x:TypeArguments="s:Exception" Name="innerEx" />
                                </ActivityAction.Argument>
                                <Sequence sap2010:WorkflowViewState.IdRef="Seq_ThrowInner">
                                  <Assign sap2010:WorkflowViewState.IdRef="Assign_ThrowInnerMsg">
                                    <Assign.To><OutArgument x:TypeArguments="x:String">[v_ExceptionMsg]</OutArgument></Assign.To>
                                    <Assign.Value><InArgument x:TypeArguments="x:String">["Post-login check failed or timed out. " &amp; innerEx.Message]</InArgument></Assign.Value>
                                  </Assign>
                                  <Throw Exception="[New System.Exception(v_ExceptionMsg)]" sap2010:WorkflowViewState.IdRef="Throw_PropagateVerify" />
                                </Sequence>
                              </ActivityAction>
                            </Catch>
                          </TryCatch.Catches>
                        </TryCatch>
                        <Assign DisplayName="Confirm PostLogin Success" sap2010:WorkflowViewState.IdRef="Assign_PostLoginConfirm">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Boolean">[v_Success]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </Sequence>
                    </If.Then>
                    <If.Else>
                      <Assign DisplayName="Mark fully success" sap2010:WorkflowViewState.IdRef="Assign_MarkTrue">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Boolean">[v_Success]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
                        </Assign.Value>
                      </Assign>
                    </If.Else>
                  </If>
                </Sequence>
              </ActivityAction>
            </ui:BrowserScope.Body>
          </ui:BrowserScope>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_Engine">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Failure Assignment Output" sap2010:WorkflowViewState.IdRef="Seq_Err">
              <Sequence.Variables>
                <Variable x:TypeArguments="x:String" Name="v_FailScreenshotPath" />
                <Variable x:TypeArguments="sd:Image" Name="v_FailScreenshotImg" />
              </Sequence.Variables>
              
              <Assign sap2010:WorkflowViewState.IdRef="Assign_ErrSuccess">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Boolean">[v_Success]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Boolean">[False]</InArgument>
                </Assign.Value>
              </Assign>
              <Assign sap2010:WorkflowViewState.IdRef="Assign_ErrMsg">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:String">[v_Error]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:String">[exception.Message]</InArgument>
                </Assign.Value>
              </Assign>
              
              <Assign sap2010:WorkflowViewState.IdRef="Assign_ScreenshotPath">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:String">[v_FailScreenshotPath]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.MyDocuments), "UiPath", "PortalSetup", "Logs", "Screenshots", "NavFail_" &amp; System.DateTime.Now.ToString("yyyyMMdd_HHmmss") &amp; ".png")]</InArgument>
                </Assign.Value>
              </Assign>
              <TryCatch DisplayName="TryCatch - Telemetry" sap2010:WorkflowViewState.IdRef="TryCatch_ScreenFail">
                <TryCatch.Try>
                  <Sequence sap2010:WorkflowViewState.IdRef="Seq_TakeScreen">
                    <ui:TakeScreenshot WaitBefore="{x:Null}" DisplayName="Screenshot on navigation failure" sap2010:WorkflowViewState.IdRef="TakeScreenshot_Fail" Screenshot="[v_FailScreenshotImg]">
                      <ui:TakeScreenshot.Target>
                        <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Selector="{x:Null}" Id="aa5d8b7a-8f52-4e42-b921-2e624cbb14c7" TimeoutMS="3000" WaitForReady="INTERACTIVE" />
                      </ui:TakeScreenshot.Target>
                    </ui:TakeScreenshot>
                    <ui:CreateDirectory ContinueOnError="True" DisplayName="Create Folder Screenshots" sap2010:WorkflowViewState.IdRef="CreateDirectory_Screenshots" Path="[System.IO.Path.GetDirectoryName(v_FailScreenshotPath)]" />
                    <ui:SaveImage DisplayName="Save screenshot" sap2010:WorkflowViewState.IdRef="SaveImage_Fail" FileName="[v_FailScreenshotPath]" Image="[v_FailScreenshotImg]" />
                  </Sequence>
                </TryCatch.Try>
                <TryCatch.Catches>
                  <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_ScreenError">
                    <ActivityAction x:TypeArguments="s:Exception">
                      <ActivityAction.Argument>
                        <DelegateInArgument x:TypeArguments="s:Exception" Name="ignoreMe" />
                      </ActivityAction.Argument>
                      <Sequence sap2010:WorkflowViewState.IdRef="Seq_LogScreenFail">
                        <Assign sap2010:WorkflowViewState.IdRef="Assign_LogScreenFail">
                          <Assign.To><OutArgument x:TypeArguments="x:String">[v_LogMsg]</OutArgument></Assign.To>
                          <Assign.Value><InArgument x:TypeArguments="x:String">["Failed to take screenshot: " &amp; ignoreMe.Message]</InArgument></Assign.Value>
                        </Assign>
                        <ui:LogMessage sap2010:WorkflowViewState.IdRef="LogMessage_ScreenFail" Level="Warn" Message="[v_LogMsg]" />
                      </Sequence>
                    </ActivityAction>
                  </Catch>
                </TryCatch.Catches>
              </TryCatch>
              
              <Sequence sap2010:WorkflowViewState.IdRef="Seq_LogFail">
                <Assign sap2010:WorkflowViewState.IdRef="Assign_LogFailMsg">
                  <Assign.To><OutArgument x:TypeArguments="x:String">[v_LogMsg]</OutArgument></Assign.To>
                  <Assign.Value><InArgument x:TypeArguments="x:String">["Navigation engine failure: " &amp; v_Error]</InArgument></Assign.Value>
                </Assign>
                <ui:LogMessage sap2010:WorkflowViewState.IdRef="LogMessage_Err" Level="Error" Message="[v_LogMsg]" />
              </Sequence>
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
      <TryCatch.Finally>
        <Sequence DisplayName="Global Outputs Wireup" sap2010:WorkflowViewState.IdRef="Seq_Finalize">
          <Assign sap2010:WorkflowViewState.IdRef="Assign_FinalBrowser">
            <Assign.To>
              <OutArgument x:TypeArguments="ui:Browser">[out_BrowserSession]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="ui:Browser">[v_Browser]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign sap2010:WorkflowViewState.IdRef="Assign_FinalSuccess">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Boolean">[out_LoginSuccess]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Boolean">[v_Success]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign sap2010:WorkflowViewState.IdRef="Assign_FinalError">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[out_ErrorMessage]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[v_Error]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </TryCatch.Finally>
    </TryCatch>
  </Sequence>
</Activity>