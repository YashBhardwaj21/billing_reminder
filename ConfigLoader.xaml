  <!-- ══════════════════════════════════════════════════════════════════ -->
  <!-- CONFIGLOADER — reads all portal JSON configs from a folder       -->
  <!-- ══════════════════════════════════════════════════════════════════ -->
  <Sequence DisplayName="ConfigLoader" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:List(scg:Dictionary(x:String, x:Object))" Name="portalList" />
      <Variable x:TypeArguments="s:String[]" Name="jsonFiles" />
      <Variable x:TypeArguments="x:String" Name="jsonContent" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Object)" Name="parsedConfig" />
      <Variable x:TypeArguments="x:String" Name="configName" />
    </Sequence.Variables>

    <!-- ═══ BLOCK 1 — Initialise output list ═══ -->
    <Assign DisplayName="Init: portalList" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(scg:Dictionary(x:String, x:Object))">[portalList]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(scg:Dictionary(x:String, x:Object))">[New List(Of Dictionary(Of String, Object))()]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Log: ConfigLoader started" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;ConfigLoader started. Scanning folder: &quot; &amp; in_PortalsFolderPath]" />

    <!-- ═══ BLOCK 2 — Guard: folder must exist ═══ -->
    <If Condition="[Not String.IsNullOrWhiteSpace(in_PortalsFolderPath) AndAlso System.IO.Directory.Exists(in_PortalsFolderPath)]" DisplayName="Check: Folder exists?" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Then — Folder found, load configs" sap2010:WorkflowViewState.IdRef="Sequence_2">

          <!-- ═══ BLOCK 3 — Enumerate JSON files ═══ -->
          <Assign DisplayName="Get: JSON file list" sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="s:String[]">[jsonFiles]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="s:String[]">[System.IO.Directory.GetFiles(in_PortalsFolderPath, "*.json")]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:LogMessage DisplayName="Log: files found" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;ConfigLoader: Found &quot; &amp; jsonFiles.Length.ToString &amp; &quot; JSON config file(s).&quot;]" />

          <!-- ═══ BLOCK 4 — For Each JSON file ═══ -->
          <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each: JSON config file" sap2010:WorkflowViewState.IdRef="ForEach_1" Values="[jsonFiles]">
            <ui:ForEach.Body>
              <ActivityAction x:TypeArguments="x:String">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="x:String" Name="filePath" />
                </ActivityAction.Argument>

                <TryCatch DisplayName="TryCatch: Parse single config" sap2010:WorkflowViewState.IdRef="TryCatch_1">
                  <TryCatch.Try>
                    <Sequence DisplayName="Try — Read and deserialize" sap2010:WorkflowViewState.IdRef="Sequence_3">

                      <!-- Read file contents -->
                      <Assign DisplayName="Read: JSON file" sap2010:WorkflowViewState.IdRef="Assign_3">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[jsonContent]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">[System.IO.File.ReadAllText(filePath, System.Text.Encoding.UTF8)]</InArgument>
                        </Assign.Value>
                      </Assign>

                      <!-- Deserialize JSON to Dictionary via InvokeCode -->
                      <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="InvokeCode: Deserialize JSON" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="{x:Null}">
                        <ui:InvokeCode.Code>
parsedConfig = Newtonsoft.Json.JsonConvert.DeserializeObject(Of Dictionary(Of String, Object))(jsonContent)
                        </ui:InvokeCode.Code>
                        <ui:InvokeCode.Arguments>
                          <InArgument x:TypeArguments="x:String" x:Key="jsonContent">[jsonContent]</InArgument>
                          <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="parsedConfig">[parsedConfig]</OutArgument>
                        </ui:InvokeCode.Arguments>
                      </ui:InvokeCode>

                      <!-- Guard: parsedConfig not nothing -->
                      <If Condition="[parsedConfig IsNot Nothing]" DisplayName="Check: Parsed OK?" sap2010:WorkflowViewState.IdRef="If_2">
                        <If.Then>
                          <Sequence DisplayName="Then — Add to list" sap2010:WorkflowViewState.IdRef="Sequence_4">
                            <!-- Add to portalList using Concat pattern -->
                            <Assign DisplayName="Append: config to portalList" sap2010:WorkflowViewState.IdRef="Assign_4">
                              <Assign.To>
                                <OutArgument x:TypeArguments="scg:List(scg:Dictionary(x:String, x:Object))">[portalList]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="scg:List(scg:Dictionary(x:String, x:Object))">[portalList.Concat(New List(Of Dictionary(Of String, Object)) From {parsedConfig}).ToList()]</InArgument>
                              </Assign.Value>
                            </Assign>
                            <!-- Extract name for logging -->
                            <Assign DisplayName="Extract: configName" sap2010:WorkflowViewState.IdRef="Assign_5">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:String">[configName]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:String">[If(parsedConfig.ContainsKey("PortalName"), parsedConfig("PortalName").ToString(), System.IO.Path.GetFileNameWithoutExtension(filePath))]</InArgument>
                              </Assign.Value>
                            </Assign>
                            <ui:LogMessage DisplayName="Log: Config loaded" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[&quot;ConfigLoader: Loaded portal config — &quot; &amp; configName]" />
                          </Sequence>
                        </If.Then>
                        <If.Else>
                          <ui:LogMessage DisplayName="Log: Null result" sap2010:WorkflowViewState.IdRef="LogMessage_4" Level="Warn" Message="[&quot;ConfigLoader: Deserialization returned Nothing for &quot; &amp; filePath]" />
                        </If.Else>
                      </If>

                    </Sequence>
                  </TryCatch.Try>
                  <TryCatch.Catches>
                    <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_1">
                      <ActivityAction x:TypeArguments="s:Exception">
                        <ActivityAction.Argument>
                          <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                        </ActivityAction.Argument>
                        <ui:LogMessage DisplayName="Log: Config load failed" sap2010:WorkflowViewState.IdRef="LogMessage_5" Level="Error" Message="[&quot;ConfigLoader ERROR: Failed to load &quot; &amp; filePath &amp; &quot; — &quot; &amp; exception.Message]" />
                      </ActivityAction>
                    </Catch>
                  </TryCatch.Catches>
                </TryCatch>

              </ActivityAction>
            </ui:ForEach.Body>
          </ui:ForEach>

        </Sequence>
      </If.Then>
      <If.Else>
        <ui:LogMessage DisplayName="Log: Folder not found" sap2010:WorkflowViewState.IdRef="LogMessage_6" Level="Warn" Message="[&quot;ConfigLoader WARNING: Portal config folder not found or path is empty — &quot; &amp; If(in_PortalsFolderPath Is Nothing, &quot;(null)&quot;, in_PortalsFolderPath)]" />
      </If.Else>
    </If>

    <!-- ═══ BLOCK 5 — Set output argument ═══ -->
    <Assign DisplayName="Set: out_PortalList" sap2010:WorkflowViewState.IdRef="Assign_6">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(scg:Dictionary(x:String, x:Object))">[out_PortalList]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(scg:Dictionary(x:String, x:Object))">[portalList]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Log: ConfigLoader complete" sap2010:WorkflowViewState.IdRef="LogMessage_7" Level="Info" Message="[&quot;ConfigLoader complete. Loaded &quot; &amp; portalList.Count.ToString &amp; &quot; portal config(s).&quot;]" />

  </Sequence>
</Activity>